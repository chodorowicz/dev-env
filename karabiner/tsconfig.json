{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"types": ["node"],
		// karabiner.ts-greg-mods is a linked package with its own dev copy of
		// karabiner.ts; force every import onto ours so builder types match.
		"paths": { "karabiner.ts": ["./node_modules/karabiner.ts"] }
	},
	"include": ["**/*.ts"],
	"exclude": ["node_modules"]
}
